---
/**
 * Original SFG-Studio-Logo, vektorisiert aus der bestehenden Website.
 * Färbt sich über `color` (currentColor) ein.
 */
import full from '../assets/logo/sfg-studio.svg?raw';
import mark from '../assets/logo/sfg-mark.svg?raw';

interface Props {
  variant?: 'full' | 'mark';
  class?: string;
  label?: string;
}
const { variant = 'full', class: className, label = 'SFG Studio' } = Astro.props;
const svg = (variant === 'full' ? full : mark).replace(
  '<svg ',
  `<svg role="img" aria-label="${label}" focusable="false" `,
);
---

<span class:list={['logo', `logo--${variant}`, className]} set:html={svg} />

<style>
  .logo {
    display: inline-block;
    line-height: 0;
  }
  .logo :global(svg) {
    width: 100%;
    height: auto;
  }
</style>
