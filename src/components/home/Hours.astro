---
import Icon from '../Icon.astro';
import { hours, hoursNote, goodMorningWindow } from '../../data/studio';
import { toMin, slotLabel } from '../../lib/hours';

const START = 8 * 60;
const END = 22 * 60;
const pos = (t: string) => ((toMin(t) - START) / (END - START)) * 100;
const ticks = [8, 10, 12, 14, 16, 18, 20, 22];
---

<section id="zeiten" class="hours section theme-light" aria-labelledby="hours-title">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow" data-reveal>Öffnungszeiten</p>
        <h2 id="hours-title" class="h1" data-split>Sieben Tage die Woche für dich da.</h2>
      </div>
      <div class="hours__side" data-reveal>
        <p class="lead">{hoursNote} Im Zweifel kurz anrufen – wir helfen gern weiter.</p>
        <label class="toggle">
          <input type="checkbox" data-gm-toggle />
          <span class="toggle__track" aria-hidden="true"><span></span></span>
          <span>„Good Morning“-Zeiten einblenden</span>
        </label>
      </div>
    </div>

    <div class="timeline" data-timeline data-reveal>
      <div class="timeline__axis mono" aria-hidden="true">
        <span></span>
        <div class="timeline__ticks">
          {ticks.map((h) => <span style={`left:${((h * 60 - START) / (END - START)) * 100}%`}>{h}</span>)}
        </div>
      </div>

      <ol role="list" class="timeline__rows">
        {
          hours.map((d, i) => {
            const gm = goodMorningWindow[i];
            return (
              <li class="row" data-day={i}>
                <div class="row__label">
                  <span class="row__name">{d.name}</span>
                  <span class="row__times mono tabular">{d.slots.map(slotLabel).join(' · ')}</span>
                  <span class="row__today mono">Heute</span>
                </div>
                <div class="row__track" aria-hidden="true">
                  {ticks.slice(1, -1).map((h) => (
                    <span class="row__grid" style={`left:${((h * 60 - START) / (END - START)) * 100}%`} />
                  ))}
                  {d.slots.map(([o, c], j) => (
                    <span
                      class="row__bar"
                      style={`left:${pos(o)}%;width:${pos(c) - pos(o)}%;--d:${i * 0.06 + j * 0.1}s`}
                    >
                      <span class="row__bar-label mono">{slotLabel([o, c])}</span>
                    </span>
                  ))}
                  {gm === 'all'
                    ? d.slots.map(([o, c]) => (
                        <span class="row__gm" style={`left:${pos(o)}%;width:${pos(c) - pos(o)}%`} />
                      ))
                    : gm.map(([o, c]) => <span class="row__gm" style={`left:${pos(o)}%;width:${pos(c) - pos(o)}%`} />)}
                  <span class="row__now" data-now hidden />
                </div>
              </li>
            );
          })
        }
      </ol>
      <p class="timeline__legend mono" aria-hidden="true">
        <span class="legend legend--open"></span> geöffnet
        <span class="legend legend--gm"></span> im Good-Morning-Tarif enthalten
        <span class="legend legend--now"></span> jetzt
      </p>
    </div>

    <a href="tel:+4965349494300" class="hours__call" data-reveal>
      <Icon name="phone" size={18} /> Fragen? 06534 9494300
    </a>
  </div>
</section>

<style>
  .hours__side {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
  }
  .toggle input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .toggle__track {
    position: relative;
    width: 50px;
    height: 30px;
    border-radius: 999px;
    background: rgb(11 16 10 / 0.15);
    transition: background-color 0.3s;
    flex: none;
  }
  .toggle__track span {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--white);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.2);
    transition: transform 0.4s var(--ease-out);
  }
  .toggle input:checked + .toggle__track {
    background: var(--green);
  }
  .toggle input:checked + .toggle__track span {
    transform: translateX(20px);
  }
  .toggle input:focus-visible + .toggle__track {
    outline: 2px solid var(--green);
    outline-offset: 3px;
  }

  .timeline {
    --label-w: 210px;
    padding: clamp(20px, 3vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid var(--line);
  }
  .timeline__axis {
    display: none;
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-bottom: 10px;
  }
  .timeline__ticks {
    position: relative;
    height: 1.2em;
  }
  .timeline__ticks span {
    position: absolute;
    transform: translateX(-50%);
  }
  .timeline__ticks span:first-child {
    transform: none;
  }
  .timeline__ticks span:last-child {
    transform: translateX(-100%);
  }

  .timeline__rows {
    display: grid;
  }
  .row {
    display: grid;
    gap: 10px;
    padding-block: 14px;
    border-top: 1px solid var(--line);
  }
  .row:first-child {
    border-top: 0;
  }
  .row__label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
  }
  .row__name {
    font-weight: 700;
    min-width: 7.5em;
  }
  .row__times {
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .row__today {
    display: none;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 999px;
    background: var(--green);
    color: var(--ink);
  }
  .row.is-today .row__today {
    display: inline-block;
  }
  .row.is-today .row__name {
    color: var(--green-text);
  }

  .row__track {
    position: relative;
    height: 32px;
    border-radius: 10px;
    background: var(--paper);
  }
  .row__grid {
    position: absolute;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--line);
  }
  .row__bar {
    position: absolute;
    top: 4px;
    bottom: 4px;
    border-radius: 7px;
    background: var(--ink);
    color: var(--text-on-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transform-origin: left;
  }
  .row.is-today .row__bar {
    background: var(--green);
    color: var(--ink);
  }
  .row__bar-label {
    font-size: 0.7rem;
    white-space: nowrap;
    display: none;
  }
  .row__gm {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 10px;
    border: 2px solid var(--green);
    background: repeating-linear-gradient(
      -45deg,
      rgb(92 171 51 / 0.28) 0 6px,
      transparent 6px 12px
    );
    opacity: 0;
    transform: scaleY(0.6);
    transition:
      opacity 0.4s,
      transform 0.5s var(--ease-out);
    pointer-events: none;
  }
  .timeline.show-gm .row__gm {
    opacity: 1;
    transform: none;
  }
  .row__now {
    position: absolute;
    top: -6px;
    bottom: -6px;
    width: 3px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: #e0715b;
    box-shadow: 0 0 0 3px var(--white);
  }
  .row__now::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 50%;
    width: 9px;
    height: 9px;
    margin-left: -4.5px;
    border-radius: 50%;
    background: inherit;
  }

  /* Bar-Animation */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .row__bar {
      transform: scaleX(0);
      transition: transform 1.1s var(--ease-out) var(--d);
    }
    :global(.js) .timeline.is-in .row__bar,
    :global(.motion-failed) .row__bar {
      transform: scaleX(1);
    }
  }

  .timeline__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin-top: 18px;
    font-size: 0.72rem;
    color: var(--text-muted);
  }
  .legend {
    width: 18px;
    height: 10px;
    border-radius: 3px;
    margin-left: 8px;
  }
  .legend:first-child {
    margin-left: 0;
  }
  .legend--open {
    background: var(--ink);
  }
  .legend--gm {
    border: 1.5px solid var(--green);
    background: repeating-linear-gradient(-45deg, rgb(92 171 51 / 0.35) 0 3px, transparent 3px 6px);
  }
  .legend--now {
    width: 3px;
    height: 14px;
    background: #e0715b;
  }

  .hours__call {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
    font-weight: 600;
    text-decoration: none;
    color: var(--green-text);
  }

  @media (min-width: 760px) {
    .timeline__axis {
      display: grid;
      grid-template-columns: var(--label-w) 1fr;
    }
    .row {
      grid-template-columns: var(--label-w) 1fr;
      align-items: center;
      gap: 0;
    }
    .row__label {
      flex-direction: column;
      gap: 2px;
    }
    .row__bar-label {
      display: block;
    }
    .row__track {
      height: 40px;
    }
  }
</style>

<script>
  import { berlinNow } from '../../lib/hours';

  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  const toggle = document.querySelector<HTMLInputElement>('[data-gm-toggle]');
  const START = 8 * 60;
  const END = 22 * 60;

  const markNow = () => {
    if (!timeline) return;
    const { dayIndex, minutes } = berlinNow();
    timeline.querySelectorAll<HTMLElement>('.row').forEach((row) => {
      const isToday = Number(row.dataset.day) === dayIndex;
      row.classList.toggle('is-today', isToday);
      const now = row.querySelector<HTMLElement>('[data-now]');
      if (!now) return;
      const visible = isToday && minutes >= START && minutes <= END;
      now.hidden = !visible;
      if (visible) now.style.left = `${((minutes - START) / (END - START)) * 100}%`;
    });
  };
  markNow();
  setInterval(markNow, 60_000);

  toggle?.addEventListener('change', () => timeline?.classList.toggle('show-gm', toggle.checked));

  // Balken einfahren, sobald die Zeitleiste sichtbar ist
  if (timeline) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          timeline.classList.add('is-in');
          io.disconnect();
        }
      },
      { threshold: 0.25 },
    );
    io.observe(timeline);
  }
</script>
