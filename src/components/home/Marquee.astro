---
interface Props {
  items: string[];
  reverse?: boolean;
  theme?: 'green' | 'dark';
}
const { items, reverse = false, theme = 'green' } = Astro.props;
---

<div
  class:list={['marquee', theme === 'green' ? 'theme-green' : 'theme-dark']}
  data-marquee={reverse ? 'reverse' : ''}
  data-duration="36"
>
  <div class="marquee__track" data-marquee-track>
    {
      [0, 1].map((copy) => (
        <ul role="list" class="marquee__list" aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((item) => (
            <li>
              <span>{item}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0c.8 6.6 5.4 11.2 12 12-6.6.8-11.2 5.4-12 12-.8-6.6-5.4-11.2-12-12C6.6 11.2 11.2 6.6 12 0Z" />
              </svg>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding-block: clamp(18px, 2.6vw, 30px);
    border-block: 1px solid var(--line);
  }
  .marquee__track {
    display: flex;
    width: max-content;
  }
  .marquee__list {
    display: flex;
    flex: none;
  }
  .marquee__list li {
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 44px);
    padding-right: clamp(20px, 3vw, 44px);
    font-size: clamp(1.6rem, 1rem + 2.6vw, 3.4rem);
    font-weight: 800;
    font-stretch: 115%;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    white-space: nowrap;
    line-height: 1;
  }
  .marquee svg {
    width: 0.55em;
    height: 0.55em;
    fill: currentColor;
    flex: none;
  }
  .theme-dark.marquee svg {
    fill: var(--green);
  }
</style>
