---
import Icon from '../Icon.astro';
import Status from '../Status.astro';
import { studio, verein, fullAddress } from '../../data/studio';

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(studio.mapsQuery)}`;
---

<section id="kontakt" class="contact section theme-dark" aria-labelledby="contact-title">
  <svg class="contact__river" viewBox="0 0 1200 600" preserveAspectRatio="none" aria-hidden="true">
    <path
      d="M-40 120 C 180 40, 260 300, 420 260 S 560 40, 720 120 S 860 460, 1000 400 S 1180 220, 1260 300"
      data-draw
    />
  </svg>

  <div class="container contact__grid">
    <div class="contact__info">
      <p class="eyebrow" data-reveal>Kontakt & Anfahrt</p>
      <h2 id="contact-title" class="h1" data-split>Komm vorbei.</h2>

      <div class="contact__address" data-reveal>
        <Icon name="pin" size={22} />
        <address>
          {studio.name}<br />
          {studio.street}<br />
          {studio.zip} {studio.city}
        </address>
        <button type="button" class="copy" data-copy={fullAddress} aria-label="Adresse kopieren">
          <Icon name="copy" size={18} />
          <span data-copy-label>Kopieren</span>
        </button>
      </div>

      <div class="btn-row" data-reveal>
        <a class="btn" href={mapsUrl} target="_blank" rel="noopener">
          Route planen <Icon name="arrow-up-right" class="btn__icon" />
        </a>
        <a class="btn btn--ghost" href={studio.phoneHref}>
          <Icon name="phone" size={18} /> Anrufen
        </a>
      </div>

      <ul role="list" class="contact__list" data-reveal>
        <li>
          <span class="contact__label mono">Telefon</span>
          <a href={studio.phoneHref}>{studio.phone}</a>
        </li>
        <li>
          <span class="contact__label mono">E-Mail</span>
          <a href={`mailto:${studio.email}`}>{studio.email}</a>
        </li>
        <li>
          <span class="contact__label mono">Jetzt</span>
          <Status />
        </li>
      </ul>

      <div class="contact__verein" data-reveal>
        <p class="contact__label mono">Kontakt zum Verein</p>
        <p>
          <strong>{verein.name}</strong><br />
          {verein.street}, {verein.zip} {verein.city}<br />
          Tel. <a href={verein.phoneHref}>{verein.phone}</a> · Fax {verein.fax}<br />
          <a href={`mailto:${verein.email}`}>{verein.email}</a> ·
          <a href={verein.web} target="_blank" rel="noopener">sfg-bks.de</a>
        </p>
      </div>
    </div>

    <form
      class="contact__form"
      name="kontakt"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      data-form
      data-reveal
    >
      <input type="hidden" name="form-name" value="kontakt" />
      <p class="hp-field">
        <label>Nicht ausfüllen: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div class="form__body" data-form-body>
        <h3 class="h3">Schreib uns eine Nachricht</h3>
        <div class="field">
          <label for="c-name">Name *</label>
          <input id="c-name" name="name" class="input" required autocomplete="name" placeholder="Vor- und Nachname" />
        </div>
        <div class="field">
          <label for="c-mail">E-Mail *</label>
          <input
            id="c-mail"
            name="email"
            type="email"
            class="input"
            required
            autocomplete="email"
            placeholder="du@beispiel.de"
          />
        </div>
        <div class="field">
          <label for="c-msg">Nachricht *</label>
          <textarea id="c-msg" name="nachricht" class="input" required placeholder="Wie können wir helfen?"></textarea>
        </div>
        <label class="check">
          <input type="checkbox" name="datenschutz" required />
          <span>
            Ich bin einverstanden, dass meine Angaben zur Beantwortung meiner Anfrage verarbeitet werden. Mehr in der{' '}
            <a href="/datenschutz">Datenschutzerklärung</a>. *
          </span>
        </label>
        <button class="btn" type="submit">
          <span data-submit-label>Nachricht senden</span>
          <Icon name="arrow-right" class="btn__icon" />
        </button>
        <p class="form__error" data-form-error hidden role="alert"></p>
      </div>

      <div class="form__success" data-form-success hidden tabindex="-1">
        <span class="form__success-icon"><Icon name="check" size={32} /></span>
        <h3 class="h3">Danke für deine Nachricht!</h3>
        <p class="muted">Wir melden uns so schnell wie möglich bei dir.</p>
      </div>
    </form>
  </div>
</section>

<style>
  .contact {
    overflow: hidden;
  }
  .contact__river {
    position: absolute;
    inset: 10% -5% auto;
    width: 110%;
    height: 70%;
    fill: none;
    stroke: var(--green);
    stroke-width: 1.5;
    opacity: 0.18;
    pointer-events: none;
  }

  .contact__grid {
    position: relative;
    display: grid;
    gap: 56px;
  }
  @media (min-width: 1000px) {
    .contact__grid {
      grid-template-columns: 1fr 1fr;
      gap: clamp(48px, 6vw, 96px);
      align-items: start;
    }
  }

  .contact__info {
    display: grid;
    gap: 32px;
    align-content: start;
  }
  .contact__info .h1 {
    margin-top: -12px;
  }

  .contact__address {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 16px;
    align-items: start;
    padding: 22px;
    border-radius: var(--radius);
    background: var(--ink-2);
    border: 1px solid var(--line-dark);
  }
  .contact__address :global(svg) {
    color: var(--green);
    margin-top: 2px;
  }
  .contact__address address {
    font-style: normal;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.45;
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgb(238 242 232 / 0.08);
    font-size: 0.82rem;
    font-weight: 600;
    transition: background-color 0.3s;
  }
  .copy:hover {
    background: rgb(238 242 232 / 0.16);
  }
  .copy.is-copied {
    background: var(--green);
    color: var(--ink);
  }

  .contact__list {
    display: grid;
  }
  .contact__list li {
    display: grid;
    grid-template-columns: 5.5em 1fr;
    align-items: center;
    gap: 16px;
    padding-block: 14px;
    border-top: 1px solid var(--line-dark);
  }
  .contact__list a {
    font-weight: 600;
    text-decoration: none;
  }
  .contact__list a:hover {
    color: var(--green-soft);
  }
  .contact__list :global(.status) {
    justify-self: start;
  }
  .contact__label {
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-on-dark);
  }
  .contact__verein {
    display: grid;
    gap: 10px;
    font-size: 0.95rem;
    color: var(--muted-on-dark);
    line-height: 1.6;
  }
  .contact__verein strong {
    color: var(--text-on-dark);
  }
  .contact__verein a {
    color: var(--text-on-dark);
  }

  .contact__form {
    position: relative;
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--ink-2);
    border: 1px solid var(--line-dark);
  }
  .form__body {
    display: grid;
    gap: 20px;
  }
  .form__body .btn {
    justify-self: start;
  }
  .form__error {
    color: #f0a08f;
    font-size: 0.92rem;
  }
  .form__success {
    display: grid;
    gap: 14px;
    justify-items: start;
    padding-block: 40px;
    outline: none;
  }
  .form__success[hidden] {
    display: none;
  }
  .form__success-icon {
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--green);
    color: var(--ink);
    animation: pop 0.7s var(--ease-out);
  }
  @keyframes pop {
    from {
      transform: scale(0.4);
      opacity: 0;
    }
  }
</style>

<script>
  import { gsap, reduceMotion } from '../../scripts/motion';
  import { initForms } from '../../scripts/forms';

  initForms();

  // Adresse kopieren
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        const label = btn.querySelector('[data-copy-label]');
        btn.classList.add('is-copied');
        if (label) label.textContent = 'Kopiert';
        setTimeout(() => {
          btn.classList.remove('is-copied');
          if (label) label.textContent = 'Kopieren';
        }, 2000);
      } catch {
        /* Zwischenablage nicht verfügbar – nichts tun */
      }
    });
  });

  // Mosel-Linie zeichnen
  const path = document.querySelector<SVGPathElement>('.contact__river [data-draw]');
  if (path && !reduceMotion) {
    const len = path.getTotalLength();
    gsap.fromTo(
      path,
      { strokeDasharray: len, strokeDashoffset: len },
      {
        strokeDashoffset: 0,
        ease: 'none',
        scrollTrigger: { trigger: '#kontakt', start: 'top 80%', end: 'center center', scrub: true },
      },
    );
  }
</script>
