---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { machines } from '../../data/studio';
import freihantel from '../../assets/img/freihantel.jpg';
import cardio from '../../assets/img/cardio.jpg';
import geraetepark from '../../assets/img/geraetepark.jpg';
import platform from '../../assets/img/platform.jpg';
import wellengangRoom from '../../assets/img/wellengang-room.jpg';

const areas = [
  {
    id: 'freihantel',
    title: 'Freihantelbereich',
    img: freihantel,
    alt: 'Freihantelbereich von oben mit Kurzhantelständern und Bänken',
    text: 'Hier sind dir keine Grenzen gesetzt. Mit Kurzhanteln, Langhanteln und Medizinbällen gestaltest du dein Training abwechslungsreich und intensiv – im Stand, auf Bänken oder an Geräten, mit Haltungskontrolle im Spiegel.',
    facts: ['Kurzhanteln 1–30 kg', 'Langhanteln 10–45 kg', 'Medizinbälle', 'Spiegelwand'],
  },
  {
    id: 'cardio',
    title: 'Cardiobereich',
    img: cardio,
    alt: 'Cardiobereich mit Laufbändern, Ergometern und Crosstrainern',
    text: 'Aufwärmen, Ausdauer trainieren, Fett verbrennen oder entspannt cool-downen: Hier startest und beendest du dein Training.',
    facts: ['Laufbänder', 'Ergometer', 'Crosstrainer'],
  },
  {
    id: 'geraetepark',
    title: 'Gerätepark',
    img: geraetepark,
    alt: 'Geführte Fitnessgeräte im Gerätepark von oben',
    text: 'Zentral im Studio stehen unsere geführten Geräte. Sie geben die Bewegung vor – ideal für sauberes, gelenkschonendes Krafttraining.',
    facts: [...machines],
  },
  {
    id: 'plattform',
    title: 'Gewichtheberplattform',
    img: platform,
    alt: 'Gewichtheberplattform mit ATX-Rack, Hantelscheiben und Kettlebells',
    text: 'Mit den ATX-Geräten trainierst du die klassischen Gewichtheber-Übungen. Dynamische Ganzkörperübungen für Schnell- und Explosivkraft – auch Kreuzheben ist möglich.',
    facts: ['Reißen', 'Umsetzen', 'Stoßen', 'Kreuzheben'],
    note: 'Nur nach vorheriger Einweisung nutzbar.',
  },
  {
    id: 'wellengang',
    title: 'Wellengang',
    img: wellengangRoom,
    alt: 'Raum für das wellengang Schwingungstraining',
    text: 'Schwingungstraining, das den menschlichen Gang simuliert – für Jedermann, unabhängig von Alter und Fitnesslevel. Kräftigung, Koordination und Gymnastik in einem Ganzkörpertraining.',
    facts: ['Gelenkschonend', 'Für jedes Alter', 'Präventionskurse'],
    href: '/wellengang',
  },
];
---

<section id="studio" class="areas theme-dark" aria-labelledby="areas-title">
  <div class="container areas__head section-head section-head--split">
    <div>
      <p class="eyebrow" data-reveal>Das Studio</p>
      <h2 id="areas-title" class="h1" data-split>Fünf Bereiche. Ein Ziel: dein Fortschritt.</h2>
    </div>
    <div class="areas__side" data-reveal>
      <p class="lead">
        Vom Freihantelbereich bis zum Schwingungstraining – gesundheitsorientiertes Fitness- und Krafttraining
        für jedes Level.
      </p>
    </div>
  </div>

  <div class="areas__stage" data-areas-stage>
  <div class="areas__viewport" data-areas>
    <ol role="list" class="areas__track" data-areas-track>
      {
        areas.map((a, i) => (
          <li class="area" id={`bereich-${a.id}`}>
            <figure class="area__media media">
              <div class="area__img" data-area-img>
                <Image src={a.img} alt={a.alt} widths={[480, 800, 1200]} sizes="(min-width: 960px) 560px, 88vw" />
              </div>
              <figcaption class="area__index mono">0{i + 1}</figcaption>
            </figure>
            <div class="area__body">
              <h3 class="area__title">{a.title}</h3>
              <p class="area__text">{a.text}</p>
              <ul role="list" class="chips area__facts">
                {a.facts.map((f) => (
                  <li class="chip">{f}</li>
                ))}
              </ul>
              {a.note && (
                <p class="area__note">
                  <Icon name="badge" size={18} /> {a.note}
                </p>
              )}
              {a.href && (
                <a href={a.href} class="link-arrow">
                  Mehr zum Wellengang <Icon name="arrow-right" />
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
  <div class="container areas__progress" aria-hidden="true">
    <span class="mono" data-areas-count>01</span>
    <span class="areas__bar"><span data-areas-bar></span></span>
    <span class="mono">0{areas.length}</span>
  </div>
  </div>
</section>

<style>
  .areas {
    position: relative;
    padding-top: var(--section);
    padding-bottom: clamp(64px, 8vw, 120px);
    overflow: clip;
  }
  .areas__side {
    display: grid;
    gap: 28px;
  }

  .areas__progress {
    display: none;
    align-items: center;
    gap: 14px;
    margin-top: 28px;
    font-size: 0.8rem;
    color: var(--muted-on-dark);
  }
  .areas__bar {
    position: relative;
    flex: 1;
    height: 2px;
    background: var(--line-dark);
    overflow: hidden;
    border-radius: 2px;
  }
  .areas__bar span {
    position: absolute;
    inset: 0;
    background: var(--green);
    transform-origin: left;
    transform: scaleX(0.2);
  }
  :global(.has-hscroll) .areas__progress {
    display: flex;
  }

  /* Standard (Mobil / reduzierte Bewegung): horizontal wischen mit Snap */
  .areas__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
  }
  .areas__viewport::-webkit-scrollbar {
    display: none;
  }
  .areas__track {
    display: flex;
    gap: 16px;
    width: max-content;
  }

  .area {
    scroll-snap-align: start;
    width: min(86vw, 520px);
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--radius-lg);
    background: var(--ink-2);
    border: 1px solid var(--line-dark);
    overflow: hidden;
  }
  .area__media {
    aspect-ratio: 4 / 3;
    border-radius: 0;
  }
  .area__img {
    position: absolute;
    inset: 0;
  }
  .area__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .area__index {
    position: absolute;
    left: 20px;
    top: 18px;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgb(11 16 10 / 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: 0.78rem;
    color: var(--text-on-dark);
  }
  .area__body {
    display: grid;
    gap: 18px;
    align-content: start;
    padding: 28px 24px 32px;
  }
  .area__title {
    font-size: clamp(1.7rem, 1.2rem + 1.6vw, 2.6rem);
    font-weight: 750;
    font-stretch: 108%;
    letter-spacing: -0.03em;
  }
  .area__text {
    color: var(--muted-on-dark);
    max-width: 52ch;
  }
  .area__facts .chip {
    border-color: rgb(238 242 232 / 0.16);
    font-size: 0.8rem;
  }
  .area__note {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--green-soft);
  }

  /* Desktop mit Bewegung: GSAP pinnt den Bereich und scrollt horizontal */
  :global(.has-hscroll) .areas__viewport {
    overflow: visible;
    scroll-snap-type: none;
    padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2));
  }
  @media (min-width: 960px) {
    .area {
      width: min(76vw, 1040px);
      grid-template-columns: 1.15fr 1fr;
      grid-template-rows: none;
      height: min(68vh, 640px);
      min-height: 480px;
    }
    .area__media {
      aspect-ratio: auto;
      height: 100%;
    }
    .area__body {
      padding: clamp(32px, 3.5vw, 52px);
      align-content: center;
    }
    .areas__track {
      gap: 24px;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion } from '../../scripts/motion';

  const section = document.querySelector<HTMLElement>('#studio');
  const stage = section?.querySelector<HTMLElement>('[data-areas-stage]');
  const viewport = section?.querySelector<HTMLElement>('[data-areas]');
  const track = section?.querySelector<HTMLElement>('[data-areas-track]');
  const bar = section?.querySelector<HTMLElement>('[data-areas-bar]');
  const count = section?.querySelector<HTMLElement>('[data-areas-count]');

  if (section && stage && viewport && track && !reduceMotion) {
    const mm = gsap.matchMedia();
    mm.add('(min-width: 960px)', () => {
      section.classList.add('has-hscroll');
      const cards = gsap.utils.toArray<HTMLElement>('.area', track);
      const distance = () => track.scrollWidth - viewport.clientWidth;

      const tween = gsap.to(track, {
        x: () => -distance(),
        ease: 'none',
        scrollTrigger: {
          trigger: stage,
          start: 'center center',
          end: () => `+=${distance()}`,
          pin: stage,
          pinSpacing: true,
          scrub: 0.8,
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            if (bar) bar.style.transform = `scaleX(${0.2 + self.progress * 0.8})`;
            const i = Math.min(cards.length, Math.floor(self.progress * cards.length) + 1);
            if (count) count.textContent = String(i).padStart(2, '0');
          },
        },
      });

      // Bild-Parallaxe innerhalb jeder Karte
      cards.forEach((card) => {
        const img = card.querySelector('[data-area-img]');
        if (!img) return;
        gsap.fromTo(
          img,
          { xPercent: -8, scale: 1.18 },
          {
            xPercent: 8,
            scale: 1.18,
            ease: 'none',
            scrollTrigger: {
              trigger: card,
              containerAnimation: tween,
              start: 'left right',
              end: 'right left',
              scrub: true,
            },
          },
        );
      });

      return () => section.classList.remove('has-hscroll');
    });
    ScrollTrigger.refresh();
  }
</script>
