import Hero from '../components/home/Hero.astro';
import Marquee from '../components/home/Marquee.astro';
import Intro from '../components/home/Intro.astro';
import Areas from '../components/home/Areas.astro';
import Offers from '../components/home/Offers.astro';
import Pricing from '../components/home/Pricing.astro';
