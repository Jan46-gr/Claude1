---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Status from '../components/Status.astro';
import { studio } from '../data/studio';

const goals = ['Muskelaufbau', 'Abnehmen', 'Rücken & Gesundheit', 'Ausdauer', 'Beweglichkeit', 'Wieder fit werden'];
const interests = [
  { id: 'wellengang', label: 'Wellengang-Kurs' },
  { id: 'scan', label: 'SCANECA 3D-Scan' },
  { id: 'bia', label: 'BIA-Analyse' },
  { id: 'plan', label: 'Trainingsplan' },
];
const times = [
  { id: 'vormittag', label: 'Vormittags', hint: '9–13 Uhr' },
  { id: 'nachmittag', label: 'Nachmittags', hint: 'ab 14:30 Uhr' },
  { id: 'abend', label: 'Abends', hint: 'bis 21:15 Uhr' },
  { id: 'wochenende', label: 'Wochenende', hint: 'Sa & So ab 9 Uhr' },
];
const levels = ['Einsteiger:in', 'Wiedereinsteiger:in', 'Fortgeschritten'];
---

<Base
  title="Kostenloses Probetraining"
  description="Jetzt kostenloses Probetraining im SFG Studio Mülheim (Mosel) anfragen – in drei kurzen Schritten, immer unter Voranmeldung."
>
  <section class="trial-page theme-dark">
    <div class="trial-page__glow" aria-hidden="true"></div>
    <div class="container trial-page__grid">
      <div class="trial-page__intro">
        <nav aria-label="Brotkrumen" class="crumbs mono" data-reveal>
          <a href="/">Start</a><span aria-hidden="true">/</span><span aria-current="page">Probetraining</span>
        </nav>
        <p class="eyebrow" data-reveal>Kostenlos &amp; unverbindlich</p>
        <h1 class="h1" data-split="load">Dein erstes Training geht auf uns.</h1>
        <p class="lead" data-reveal>
          Erzähl uns kurz, was du vorhast – wir melden uns und vereinbaren einen Termin für dein kostenloses
          Probetraining.
        </p>

        <ul role="list" class="perks" data-reveal>
          <li><Icon name="check" size={18} /> Immer unter Voranmeldung</li>
          <li><Icon name="badge" size={18} /> Betreut von lizenzierten Trainern</li>
          <li><Icon name="accessible" size={18} /> Barrierefreies Studio</li>
        </ul>

        <div class="trial-page__contact" data-reveal>
          <p class="muted">Lieber direkt?</p>
          <a href={studio.phoneHref} class="trial-page__phone"><Icon name="phone" size={20} /> {studio.phone}</a>
          <Status />
        </div>
      </div>

      <form
        class="wizard"
        name="probetraining"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-wizard
        novalidate
        data-reveal
      >
        <input type="hidden" name="form-name" value="probetraining" />
        <p class="hp-field"><label>Nicht ausfüllen: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

        <div data-form-body>
          <div class="wizard__progress" aria-hidden="true">
            <span class="wizard__bar"><span data-wizard-bar></span></span>
            <span class="mono wizard__count"><span data-wizard-current>1</span> / 3</span>
          </div>

          <!-- Schritt 1 -->
          <fieldset class="step" data-step="1">
            <legend class="step__title">Was möchtest du erreichen?</legend>
            <p class="step__hint muted">Mehrfachauswahl möglich.</p>
            <div class="options">
              {
                goals.map((g) => (
                  <label class="option">
                    <input type="checkbox" name="ziele" value={g} />
                    <span>{g}</span>
                  </label>
                ))
              }
            </div>
            <p class="step__sub">Interesse an weiteren Angeboten?</p>
            <div class="options">
              {
                interests.map((i) => (
                  <label class="option option--soft">
                    <input type="checkbox" name="interesse" value={i.label} data-interest={i.id} />
                    <span>{i.label}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <!-- Schritt 2 -->
          <fieldset class="step" data-step="2" hidden>
            <legend class="step__title">Wann passt es dir am besten?</legend>
            <div class="options options--grid" data-required-group="zeit">
              {
                times.map((t) => (
                  <label class="option option--card">
                    <input type="radio" name="zeit" value={t.label} required />
                    <span>
                      <strong>{t.label}</strong>
                      <small>{t.hint}</small>
                    </span>
                  </label>
                ))
              }
            </div>
            <p class="step__sub">Deine Erfahrung</p>
            <div class="options">
              {
                levels.map((l) => (
                  <label class="option">
                    <input type="radio" name="erfahrung" value={l} />
                    <span>{l}</span>
                  </label>
                ))
              }
            </div>
            <p class="step__error" data-step-error hidden role="alert">Bitte wähle eine Tageszeit aus.</p>
          </fieldset>

          <!-- Schritt 3 -->
          <fieldset class="step" data-step="3" hidden>
            <legend class="step__title">Wie erreichen wir dich?</legend>
            <div class="fields">
              <div class="field">
                <label for="p-name">Name *</label>
                <input id="p-name" name="name" class="input" required autocomplete="name" />
              </div>
              <div class="field">
                <label for="p-phone">Telefon *</label>
                <input id="p-phone" name="telefon" type="tel" class="input" required autocomplete="tel" />
              </div>
              <div class="field field--full">
                <label for="p-mail">E-Mail *</label>
                <input id="p-mail" name="email" type="email" class="input" required autocomplete="email" />
              </div>
              <div class="field field--full">
                <label for="p-msg">Noch etwas, das wir wissen sollten?</label>
                <textarea id="p-msg" name="nachricht" class="input" placeholder="z. B. Beschwerden, Wunschtermin …"></textarea>
              </div>
            </div>
            <label class="check">
              <input type="checkbox" name="datenschutz" required />
              <span>
                Ich bin einverstanden, dass meine Angaben zur Terminvereinbarung verarbeitet werden. Mehr in der{' '}
                <a href="/datenschutz">Datenschutzerklärung</a>. *
              </span>
            </label>
            <p class="form__error" data-form-error hidden role="alert"></p>
          </fieldset>

          <div class="wizard__nav">
            <button type="button" class="btn btn--ghost" data-wizard-back hidden>Zurück</button>
            <button type="button" class="btn" data-wizard-next>
              Weiter <Icon name="arrow-right" class="btn__icon" />
            </button>
            <button type="submit" class="btn" data-wizard-submit hidden>
              <span data-submit-label>Probetraining anfragen</span>
              <Icon name="arrow-right" class="btn__icon" />
            </button>
          </div>
        </div>

        <div class="form__success" data-form-success hidden tabindex="-1">
          <span class="form__success-icon"><Icon name="check" size={34} /></span>
          <h2 class="h2">Danke, wir melden uns!</h2>
          <p class="muted">
            Deine Anfrage ist bei uns angekommen. Wir rufen dich zurück, um einen Termin für dein Probetraining zu
            vereinbaren.
          </p>
          <a class="btn btn--ghost" href="/">Zur Startseite</a>
        </div>
      </form>
    </div>
  </section>
</Base>

<style>
  .trial-page {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + clamp(40px, 7vh, 88px));
    padding-bottom: clamp(64px, 9vw, 120px);
  }
  .trial-page__glow {
    position: absolute;
    width: 80vmax;
    height: 80vmax;
    left: -30vmax;
    bottom: -50vmax;
    background: radial-gradient(closest-side, rgb(92 171 51 / 0.26), transparent);
    pointer-events: none;
  }
  .trial-page__grid {
    position: relative;
    display: grid;
    gap: 48px;
  }
  @media (min-width: 1000px) {
    .trial-page__grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: clamp(48px, 6vw, 96px);
      align-items: start;
    }
    .trial-page__intro {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
  }
  .trial-page__intro {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .crumbs {
    display: flex;
    gap: 10px;
    font-size: 0.78rem;
    color: var(--muted-on-dark);
  }
  .crumbs a {
    text-decoration: none;
  }
  .trial-page .lead {
    color: var(--text-on-dark);
    opacity: 0.84;
  }
  .perks {
    display: grid;
    gap: 10px;
    font-weight: 550;
  }
  .perks li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .perks :global(svg) {
    color: var(--green);
  }
  .trial-page__contact {
    display: grid;
    gap: 10px;
    justify-items: start;
    padding-top: 24px;
    border-top: 1px solid var(--line-dark);
    width: 100%;
  }
  .trial-page__phone {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1.4rem;
    font-weight: 700;
    text-decoration: none;
  }
  .trial-page__phone:hover {
    color: var(--green-soft);
  }

  /* Wizard */
  .wizard {
    position: relative;
    padding: clamp(20px, 3.5vw, 44px);
    border-radius: var(--radius-lg);
    background: var(--white);
    color: var(--text);
    --text-muted: #4a5446;
    --line: rgb(11 16 10 / 0.12);
    --green-text: #2f6d12;
    box-shadow: 0 40px 100px -40px rgb(0 0 0 / 0.6);
  }
  .wizard__progress {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 32px;
  }
  .wizard__bar {
    position: relative;
    flex: 1;
    height: 6px;
    border-radius: 999px;
    background: var(--paper-2);
    overflow: hidden;
  }
  .wizard__bar span {
    position: absolute;
    inset: 0;
    background: var(--green);
    border-radius: inherit;
    transform-origin: left;
    transform: scaleX(0.333);
    transition: transform 0.6s var(--ease-out);
  }
  .wizard__count {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .step {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
    display: grid;
    gap: 16px;
    animation: step-in 0.55s var(--ease-out);
  }
  .step[hidden] {
    display: none;
  }
  @keyframes step-in {
    from {
      opacity: 0;
      transform: translateX(24px);
    }
  }
  .step__title {
    padding: 0;
    font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.4rem);
    font-weight: 750;
    font-stretch: 108%;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 4px;
  }
  .step__hint {
    margin-top: -8px;
    font-size: 0.92rem;
  }
  .step__sub {
    margin-top: 16px;
    font-family: var(--mono);
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .step__error {
    color: #b3412b;
    font-weight: 600;
    font-size: 0.92rem;
  }

  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .options--grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  }
  .option {
    position: relative;
    cursor: pointer;
  }
  .option input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .option > span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1.5px solid var(--line);
    background: var(--white);
    font-weight: 600;
    font-size: 0.95rem;
    transition:
      background-color 0.25s,
      border-color 0.25s,
      color 0.25s,
      transform 0.3s var(--ease-out);
  }
  .option:hover > span {
    border-color: var(--green);
  }
  .option input:checked + span {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }
  .option input:checked + span::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
  }
  .option input:focus-visible + span {
    outline: 2px solid var(--green);
    outline-offset: 2px;
  }
  .option--soft input:checked + span {
    background: var(--green);
    border-color: var(--green);
    color: var(--ink);
  }
  .option--soft input:checked + span::before {
    background: var(--ink);
  }
  .option--card > span {
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    padding: 18px 20px;
    border-radius: var(--radius);
  }
  .option--card small {
    font-weight: 500;
    color: var(--text-muted);
  }
  .option--card input:checked + span small {
    color: rgb(238 242 232 / 0.7);
  }
  .option--card input:checked + span::before {
    position: absolute;
    right: 18px;
    top: 18px;
  }

  .fields {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .fields {
      grid-template-columns: 1fr 1fr;
    }
    .field--full {
      grid-column: 1 / -1;
    }
  }
  textarea.input {
    min-height: 110px;
  }
  .check {
    margin-top: 6px;
  }

  .wizard__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .wizard__nav [data-wizard-next],
  .wizard__nav [data-wizard-submit] {
    margin-left: auto;
  }
  .wizard .btn--ghost {
    box-shadow: inset 0 0 0 1.5px rgb(11 16 10 / 0.2);
  }
  .form__error {
    color: #b3412b;
    font-size: 0.92rem;
  }

  .form__success {
    display: grid;
    gap: 18px;
    justify-items: start;
    padding-block: 24px;
    outline: none;
  }
  .form__success[hidden] {
    display: none;
  }
  .form__success-icon {
    width: 72px;
    height: 72px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--green);
    color: var(--ink);
    animation: pop 0.7s var(--ease-out);
  }
  @keyframes pop {
    from {
      transform: scale(0.4);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .step,
    .form__success-icon {
      animation: none;
    }
  }
</style>

<script>
  import { submitForm, showSuccess } from '../scripts/forms';

  const form = document.querySelector<HTMLFormElement>('[data-wizard]');
  if (form) {
    const steps = [...form.querySelectorAll<HTMLFieldSetElement>('[data-step]')];
    const back = form.querySelector<HTMLButtonElement>('[data-wizard-back]')!;
    const next = form.querySelector<HTMLButtonElement>('[data-wizard-next]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-wizard-submit]')!;
    const bar = form.querySelector<HTMLElement>('[data-wizard-bar]');
    const current = form.querySelector<HTMLElement>('[data-wizard-current]');
    let index = 0;

    // Vorauswahl über ?anliegen=scan|wellengang|bia|plan
    const preset = new URLSearchParams(location.search).get('anliegen');
    if (preset) {
      const box = form.querySelector<HTMLInputElement>(`[data-interest="${preset}"]`);
      if (box) box.checked = true;
    }

    const show = (i: number, focus = true) => {
      index = i;
      steps.forEach((s, j) => (s.hidden = j !== i));
      back.hidden = i === 0;
      next.hidden = i === steps.length - 1;
      submit.hidden = i !== steps.length - 1;
      if (bar) bar.style.transform = `scaleX(${(i + 1) / steps.length})`;
      if (current) current.textContent = String(i + 1);
      if (focus) steps[i].querySelector<HTMLElement>('input, textarea')?.focus({ preventScroll: true });
      const top = form.getBoundingClientRect().top + window.scrollY - 110;
      if (focus && window.scrollY > top) {
        const lenis = (window as any).__lenis;
        lenis ? lenis.scrollTo(top) : window.scrollTo({ top, behavior: 'smooth' });
      }
    };

    const validStep = (i: number) => {
      const step = steps[i];
      const error = step.querySelector<HTMLElement>('[data-step-error]');
      const group = step.querySelector<HTMLElement>('[data-required-group]');
      if (group) {
        const name = group.dataset.requiredGroup!;
        const ok = !!form.querySelector(`input[name="${name}"]:checked`);
        if (error) error.hidden = ok;
        if (!ok) group.querySelector<HTMLInputElement>('input')?.focus();
        return ok;
      }
      const fields = [...step.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')];
      for (const f of fields) {
        if (!f.checkValidity()) {
          f.reportValidity();
          return false;
        }
      }
      return true;
    };

    next.addEventListener('click', () => {
      if (validStep(index)) show(index + 1);
    });
    back.addEventListener('click', () => show(index - 1));
    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'zeit') form.querySelector<HTMLElement>('[data-step-error]')!.hidden = true;
    });
    // Enter in Schritt 1/2 → weiter statt absenden
    form.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && index < steps.length - 1 && (e.target as HTMLElement).tagName !== 'TEXTAREA') {
        e.preventDefault();
        next.click();
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validStep(index)) return;
      const label = form.querySelector<HTMLElement>('[data-submit-label]');
      const error = form.querySelector<HTMLElement>('[data-form-error]');
      const original = label?.textContent;
      if (label) label.textContent = 'Wird gesendet …';
      submit.disabled = true;
      try {
        await submitForm(form);
        showSuccess(form);
      } catch {
        if (error) {
          error.hidden = false;
          error.textContent = 'Das hat leider nicht geklappt. Bitte ruf uns kurz an: 06534 9494300.';
        }
      } finally {
        if (label && original) label.textContent = original;
        submit.disabled = false;
      }
    });

    show(0, false);
  }
</script>
